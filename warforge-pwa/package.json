{
  "name": "warforge-pwa",
  "private": true,
  "version": "0.2.1",
  "description": "Application locale de création de listes Warhammer 40,000.",
  "author": "Warforge",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "simulator:project": "node scripts/simulator-project.mjs",
    "simulator:project:check": "node scripts/simulator-project.mjs check",
    "simulator:project:render": "node scripts/simulator-project.mjs render",
    "simulator:project:status": "node scripts/simulator-project.mjs status",
    "simulator:status": "node scripts/simulator-project.mjs render",
    "simulator:validate": "node scripts/validate-simulator-data.mjs",
    "simulator:data:sync": "node scripts/sync-simulator-data.mjs",
    "gdm:import": "node scripts/import-gdmissions-11th.mjs --run",
    "missions:validate": "node scripts/mission-data.mjs --check",
    "strategy:seed-guides": "node scripts/seed-primary-guides.mjs",
    "strategy:generate-secondary": "node scripts/strategy-knowledge.mjs --generate-secondary",
    "strategy:validate": "node scripts/strategy-knowledge.mjs --check",
    "reports:statistics": "pnpm sync-data && tsx scripts/generate-statistics-reports.ts",
    "reports:detachments": "pnpm sync-data && tsx scripts/generate-detachment-inventory-report.ts",
    "reports:detachments:validate": "node scripts/validate-detachment-inventory-report.mjs",
    "reports:detachments:expert": "pnpm reports:detachments && tsx scripts/generate-expert-detachment-report.ts",
    "reports:detachments:expert:validate": "node scripts/validate-expert-detachment-report.mjs",
    "faction-packs:validate": "node scripts/faction-pack-audit.mjs --check",
    "rules:extract": "python scripts/extract-core-rules.py && node scripts/validate-rules.mjs",
    "rules:validate": "node scripts/validate-rules.mjs",
    "locales:sync": "node scripts/sync-mfm-unit-locales.mjs",
    "inventory:index": "node scripts/export-catalog-unit-index.mjs",
    "inventory:migrate": "node scripts/migrate-inventory-csv.mjs",
    "inventory:rebase": "node scripts/rebase-inventory-csv.mjs",
    "images:fetch": "node scripts/fetch-unit-images.mjs --write",
    "images:prepare": "python scripts/prepare-unit-images.py --write",
    "images:build": "node scripts/build-unit-image-manifest.mjs",
    "images:validate": "node scripts/build-unit-image-manifest.mjs --check --strict",
    "predev": "pnpm sync-data",
    "prebuild": "pnpm sync-data",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "pnpm faction-packs:validate && pnpm sync-data && tsc -b && vite build --mode github-pages",
    "build:desktop:ui": "pnpm sync-data && tsc -b && vite build --mode desktop",
    "build:desktop": "pnpm build:desktop:ui && node scripts/package-desktop.mjs",
    "build:android:web": "pnpm sync-data && tsc -b && vite build --mode android",
    "android:sync": "pnpm build:android:web && cap sync android",
    "build:android": "pnpm android:sync && android\\gradlew.bat -p android assembleDebug && node scripts/package-android.mjs",
    "preview": "vite preview",
    "lint": "tsc -b",
    "test": "vitest run --config vite.config.ts",
    "test:browser": "playwright test",
    "verify": "pnpm simulator:project:check && pnpm simulator:validate && pnpm faction-packs:validate && pnpm sync-data && pnpm missions:validate && pnpm images:validate && pnpm rules:validate && pnpm test && pnpm test:browser && pnpm build",
    "test:watch": "vitest --config vite.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@vitejs/plugin-react": "6.0.5",
    "@xstate/react": "^6.1.0",
    "i18next": "26.3.6",
    "pixi.js": "^8.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.warforge.app",
    "productName": "Warforge 40k",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Warforge 40k"
    }
  }
}
