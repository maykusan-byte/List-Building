{
  "name": "warforge-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "inventory:index": "node scripts/export-catalog-unit-index.mjs",
    "inventory:migrate": "node scripts/migrate-inventory-csv.mjs",
    "inventory:rebase": "node scripts/rebase-inventory-csv.mjs",
    "predev": "pnpm sync-data",
    "prebuild": "pnpm sync-data",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "pnpm sync-data && tsc -b && vite build --mode github-pages",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
