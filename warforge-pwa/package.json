{
  "name": "warforge-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "rules:extract": "python scripts/extract-core-rules.py && node scripts/validate-rules.mjs",
    "rules:validate": "node scripts/validate-rules.mjs",
    "locales:sync": "node scripts/sync-mfm-unit-locales.mjs",
    "inventory:index": "node scripts/export-catalog-unit-index.mjs",
    "inventory:migrate": "node scripts/migrate-inventory-csv.mjs",
    "inventory:rebase": "node scripts/rebase-inventory-csv.mjs",
    "images:fetch": "node scripts/fetch-unit-images.mjs --write",
    "images:prepare": "python scripts/prepare-unit-images.py --write",
    "images:build": "node scripts/build-unit-image-manifest.mjs",
    "images:validate": "node scripts/build-unit-image-manifest.mjs --check --strict",
    "predev": "npm run sync-data",
    "prebuild": "npm run sync-data",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "npm run sync-data && tsc -b && vite build --mode github-pages",
    "preview": "vite preview",
    "lint": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "i18next": "^26.3.6",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "^17.0.11",
    "vite": "latest",
    "vite-plugin-pwa": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
