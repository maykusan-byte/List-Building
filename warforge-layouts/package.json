{
  "name": "warforge-layouts",
  "private": true,
  "version": "1.0.0",
  "description": "Aide à la pose des 45 layouts GDM : mesures, empreintes et composition des décors.",
  "author": "Warforge",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3012",
    "build": "pnpm data:validate && tsc --noEmit && vite build",
    "build:pages": "pnpm data:validate && tsc --noEmit && vite build --mode github-pages",
    "preview": "vite preview --host 127.0.0.1 --port 4182",
    "data:import": "python scripts/import-layouts.py",
    "data:validate": "node scripts/validate-data.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build:desktop": "pnpm build && node scripts/package-desktop.mjs",
    "build:android": "pnpm build && cap sync android && node scripts/package-android.mjs",
    "android:signing": "node scripts/setup-signing.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.warforge.layouts",
    "productName": "Warforge Layouts",
    "compression": "maximum",
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Warforge Layouts"
    }
  }
}
